@page
@model LiquidacionSueldos.Web.Pages.Liquidacion.DetalleModel
@{
    ViewData["Title"] = "Detalle de liquidación";
    var e = Model.Linea!.Empleado!;
    var c = Model.Calculo;
}
<section class="view active">
    <div class="view-head">
        <h1>@e.NombreCompleto</h1>
        <p>@Fmt.PeriodoLargo(Model.Periodo) · @Model.Tipo @(Model.Cerrada ? "· cerrada" : "· borrador")</p>
    </div>
    <partial name="_Alert" model="(Model.Ok, Model.Error)" />

    <div class="grid-2">
        <div class="panel calc-lines">
            <h3>Cálculo</h3>
            <div class="calc-row"><span>Sueldo básico</span><strong>@Fmt.Money(c.Basico)</strong></div>
            <div class="calc-row"><span>Antigüedad (@c.Anios año@(c.Anios == 1 ? "" : "s"))</span><strong>@Fmt.Money(c.Antiguedad)</strong></div>
            <div class="calc-row"><span>Presentismo</span><strong>@Fmt.Money(c.Presentismo)</strong></div>
            <div class="calc-row"><span>Horas extra 50%</span><strong>@Fmt.Money(c.He50)</strong></div>
            <div class="calc-row"><span>Horas extra 100%</span><strong>@Fmt.Money(c.He100)</strong></div>
            @foreach (var r in c.ConceptoRows.Where(r => r.Tipo == "rem")) { <div class="calc-row sub"><span>@r.Nombre</span><strong>@Fmt.Money(r.Valor)</strong></div> }
            <div class="calc-row"><span><strong>Total remunerativo</strong></span><strong>@Fmt.Money(c.Remunerativo)</strong></div>
            @foreach (var r in c.ConceptoRows.Where(r => r.Tipo == "noRem")) { <div class="calc-row sub"><span>@r.Nombre</span><strong>@Fmt.Money(r.Valor)</strong></div> }
            <div class="calc-row"><span>Total no remunerativo</span><strong>@Fmt.Money(c.NoRem)</strong></div>
            <div class="calc-row neg"><span>Jubilación</span><strong>@Fmt.Money(c.Jubilacion)</strong></div>
            <div class="calc-row neg"><span>Ley 19.032 (INSSJP)</span><strong>@Fmt.Money(c.Inssjp)</strong></div>
            <div class="calc-row neg"><span>Obra social</span><strong>@Fmt.Money(c.ObraSocial)</strong></div>
            <div class="calc-row neg"><span>Cuota sindical</span><strong>@Fmt.Money(c.Sindicato)</strong></div>
            @foreach (var r in c.ConceptoRows.Where(r => r.Tipo == "desc")) { <div class="calc-row neg"><span>@r.Nombre</span><strong>@Fmt.Money(r.Valor)</strong></div> }
            @if (c.Otros > 0) { <div class="calc-row neg"><span>Adelantos / otros descuentos</span><strong>@Fmt.Money(c.Otros)</strong></div> }
            <div class="calc-row"><span><strong>Total descuentos</strong></span><strong>@Fmt.Money(c.Descuentos)</strong></div>
            <div class="calc-row"><span><strong>Neto a pagar</strong></span><strong>@Fmt.Money(c.Neto)</strong></div>
        </div>

        <div>
            <div class="panel calc-lines">
                <h3>Costo laboral del empleador</h3>
                <div class="calc-row"><span>Bruto total</span><strong>@Fmt.Money(Model.Costo.BrutoTotal)</strong></div>
                <div class="calc-row sub"><span>Jubilación patronal</span><strong>@Fmt.Money(Model.Costo.ContribJub)</strong></div>
                <div class="calc-row sub"><span>Obra social patronal</span><strong>@Fmt.Money(Model.Costo.ContribOS)</strong></div>
                <div class="calc-row sub"><span>ART</span><strong>@Fmt.Money(Model.Costo.ContribArt)</strong></div>
                <div class="calc-row sub"><span>Asignaciones familiares</span><strong>@Fmt.Money(Model.Costo.ContribAsig)</strong></div>
                <div class="calc-row sub"><span>Sindical patronal</span><strong>@Fmt.Money(Model.Costo.ContribSind)</strong></div>
                <div class="calc-row"><span>Contribuciones</span><strong>@Fmt.Money(Model.Costo.ContribTotal)</strong></div>
                <div class="calc-row"><span><strong>Costo total</strong></span><strong>@Fmt.Money(Model.Costo.CostoTotal)</strong></div>
            </div>

            <div class="panel" style="margin-top:16px;">
                <h3>Conceptos adicionales</h3>
                <p class="hint">Los conceptos «a elección» se agregan acá, empleado por empleado, con la base de cálculo que necesites. Los automáticos ya se aplican a todos; podés fijarles un importe propio para este empleado (0 lo quita del recibo).</p>
                @{
                    string BaseTxt(string cal) => cal switch
                    {
                        "pctBasico" => "% del básico", "pctHaberes" => "% de haberes", "pctRemunerativo" => "% del total remunerativo",
                        "pctNoRemunerativo" => "% del total no remunerativo", "pctBruto" => "% del bruto (rem. + no rem.)", _ => "importe fijo"
                    };
                    var agregados = Model.Conceptos.Where(k => Model.Agregados.ContainsKey(k.Id)).ToList();
                    var disponibles = Model.Conceptos.Where(k => k.Manual && !Model.Agregados.ContainsKey(k.Id)).ToList();
                }
                @if (agregados.Count > 0)
                {
                    <h4 style="margin:10px 0 6px;">Agregados a este empleado</h4>
                    @foreach (var k in agregados)
                    {
                        var ag = Model.Agregados[k.Id];
                        <div class="calc-row sub">
                            <span>@k.Nombre · @BaseTxt(ag.Calculo) · @(ag.Calculo == "fijo" ? Fmt.Money(ag.Valor) : Fmt.Pct(ag.Valor))</span>
                            @if (!Model.Cerrada)
                            {
                                <form method="post" asp-page-handler="Quitar" class="inline-form">
                                    <input type="hidden" name="Periodo" value="@Model.Periodo" />
                                    <input type="hidden" name="Tipo" value="@Model.Tipo" />
                                    <input type="hidden" name="EmpleadoId" value="@Model.EmpleadoId" />
                                    <input type="hidden" name="conceptoId" value="@k.Id" />
                                    <button class="btn-small btn-danger-outline" type="submit">Quitar</button>
                                </form>
                            }
                        </div>
                    }
                }
                @if (!Model.Cerrada)
                {
                    <h4 style="margin:14px 0 6px;">Agregar un concepto</h4>
                    @if (disponibles.Count == 0)
                    {
                        <p class="hint">No hay conceptos «a elección» disponibles. Creá uno en Conceptos y elegí «A elección: lo agrego empleado por empleado».</p>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Agregar">
                            <input type="hidden" name="Periodo" value="@Model.Periodo" />
                            <input type="hidden" name="Tipo" value="@Model.Tipo" />
                            <input type="hidden" name="EmpleadoId" value="@Model.EmpleadoId" />
                            <div class="field" style="margin-bottom:10px;"><label>Concepto</label>
                                <select name="conceptoId">
                                    @foreach (var k in disponibles) { <option value="@k.Id">@k.Nombre (@(k.Tipo == "haber" ? (k.Remunerativo ? "haber remunerativo" : "haber no remunerativo") : "descuento"))</option> }
                                </select></div>
                            <div class="field" style="margin-bottom:10px;"><label>Calcular sobre</label>
                                <select name="calculo">
                                    <option value="fijo">Importe fijo ($)</option>
                                    <option value="pctBasico">% del sueldo básico</option>
                                    <option value="pctHaberes">% de haberes (básico + antigüedad + presentismo + HE)</option>
                                    <option value="pctRemunerativo">% del total remunerativo (solo descuentos)</option>
                                    <option value="pctNoRemunerativo">% del total no remunerativo (solo descuentos)</option>
                                    <option value="pctBruto">% del total bruto: remunerativo + no remunerativo (solo descuentos)</option>
                                </select></div>
                            <div class="field" style="margin-bottom:10px;"><label>Valor ($ si es fijo, % en los demás casos)</label>
                                <input name="valor" type="number" step="any" min="0" required /></div>
                            <button class="btn-primary" type="submit">Agregar a este empleado</button>
                        </form>
                    }
                }

                @if (Model.Conceptos.Any(k => !k.Manual))
                {
                    <h4 style="margin:18px 0 6px;">Conceptos automáticos (importe propio)</h4>
                    <form method="post">
                        <input type="hidden" name="Periodo" value="@Model.Periodo" />
                        <input type="hidden" name="Tipo" value="@Model.Tipo" />
                        <input type="hidden" name="EmpleadoId" value="@Model.EmpleadoId" />
                        @foreach (var k in Model.Conceptos.Where(k => !k.Manual))
                        {
                            var ovTxt = Model.Overrides.TryGetValue(k.Id, out var ov) ? Fmt.Input(ov) : "";
                            <div class="field" style="margin-bottom:10px;">
                                <label>@k.Nombre (@(k.Tipo == "haber" ? (k.Remunerativo ? "haber remunerativo" : "haber no remunerativo") : "descuento"))</label>
                                <input name="ov_@k.Id" type="number" step="0.01" min="0" readonly="@Model.Cerrada" value="@ovTxt" />
                            </div>
                        }
                        @if (!Model.Cerrada) { <button class="btn-primary" type="submit">Guardar importes</button> }
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="page-actions" style="margin-top:16px;">
        <a class="btn-secondary" asp-page="Index" asp-route-periodo="@Model.Periodo" asp-route-tipo="@Model.Tipo">← Volver a la liquidación</a>
        <a class="btn-secondary" asp-page="/Recibo/Index" asp-route-liquidacionId="@(Model.Liq!.Id)" asp-route-empleadoId="@Model.EmpleadoId">Ver recibo</a>
    </div>
</section>
