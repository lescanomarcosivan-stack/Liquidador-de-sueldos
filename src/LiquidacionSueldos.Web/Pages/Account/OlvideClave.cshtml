@page
@model OlvideClaveModel
@{ Layout = "_PublicLayout"; ViewData["Title"] = "Recuperar contraseña"; }
<div class="login-box">
    <h2>Recuperar contraseña</h2>
    @if (Model.Enviado)
    {
        <div class="alert ok">Si el email está registrado, te enviamos un enlace para elegir una contraseña nueva. Revisá también la carpeta de spam. El enlace vence en 1 hora.</div>
        <p class="hint" style="margin-top:14px;"><a asp-page="Login">Volver a ingresar</a></p>
    }
    else
    {
        <p class="hint">Ingresá el email de tu usuario y te enviamos un enlace para restablecerla.</p>
        @if (!ModelState.IsValid) { <div class="alert error">@foreach (var e in ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div> }
        <form method="post">
            <label for="Email">Email</label>
            <input id="Email" asp-for="Email" type="email" autocomplete="username" required autofocus />
            <button type="submit" class="btn-primary" style="width:100%;margin-top:16px;">Enviar enlace</button>
        </form>
        <p class="hint" style="margin-top:14px;"><a asp-page="Login">Volver</a></p>
    }
</div>
