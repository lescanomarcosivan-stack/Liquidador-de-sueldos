@page
@model LoginModel
@{ Layout = "_PublicLayout"; ViewData["Title"] = "Ingresar"; }
<div class="login-box">
    <h2>Liquidación de Sueldos</h2>
    <p class="hint">Ingresá con tu usuario del estudio.</p>
    @if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert error">@Model.Error</div> }
    <form method="post">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <label for="Email">Email</label>
        <input id="Email" asp-for="Input.Email" type="email" autocomplete="username" required autofocus />
        <label for="Password">Contraseña</label>
        <input id="Password" asp-for="Input.Password" type="password" autocomplete="current-password" required />
        <button type="submit" class="btn-primary" style="width:100%;margin-top:16px;">Ingresar</button>
    </form>
    <p class="hint" style="margin-top:14px;"><a asp-page="OlvideClave">¿Olvidaste tu contraseña?</a></p>
    <p class="hint" style="margin-top:6px;">¿Primera vez? <a asp-page="Register">Registrar mi estudio</a></p>
</div>
